# Sao chép thành .env rồi sửa theo máy của bạn
PORT=3000

# Địa chỉ WebSocket mà thiết bị sẽ kết nối (IP LAN của máy chủ)
# Để trống thì server tự lấy theo địa chỉ thiết bị gọi OTA
PUBLIC_WS_URL=
# Token xác thực thiết bị, để trống = không kiểm tra
AUTH_TOKEN=

# ASR (nhận dạng giọng nói): whispercpp | openai
ASR_TYPE=whispercpp
ASR_URL=http://localhost:8080
ASR_LANGUAGE=vi
WHISPER_MODEL=ggml-small.bin

# LLM: API tương thích OpenAI (Ollama, llama.cpp server, LM Studio...)
LLM_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
# LLM_SYSTEM_PROMPT=Bạn là Tiểu Trí...

# TTS (đọc văn bản): piper | openai
TTS_TYPE=piper
TTS_URL=http://localhost:5000/synthesize
PIPER_VOICE=vi_VN-vais1000-medium

# Âm thanh / VAD
OUTPUT_SAMPLE_RATE=24000
VAD_THRESHOLD=500
VAD_SILENCE_MS=800
