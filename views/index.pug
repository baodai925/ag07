extends layout
include partials/attendance-table

block content
  section.hero
    .container
      h2 Chấm công bằng camera
      p Nhân viên chỉ cần nhìn vào camera — hệ thống tự nhận diện khuôn mặt và ghi giờ vào/ra.
      a.btn(href="/cham-cong") Mở màn hình chấm công

  section.features
    .container
      h2 Hôm nay (#{summary.date})

      .grid.stats
        .card.stat
          span.stat-value= summary.totalEmployees
          span.stat-label Tổng nhân viên
        .card.stat
          span.stat-value.ok= summary.present
          span.stat-label Đã chấm công
        .card.stat
          span.stat-value.warn= summary.late
          span.stat-label Đi muộn (sau #{workStart})
        .card.stat
          span.stat-value.bad= summary.absent
          span.stat-label Chưa chấm

      if summary.totalEmployees === 0
        p.empty
          | Chưa có nhân viên nào. 
          a(href="/nhan-vien") Đăng ký khuôn mặt nhân viên
          |  để bắt đầu.
      else
        +attendanceTable(summary.today)
